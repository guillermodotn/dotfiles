{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "base": "#292520",
    "surface": "#322d27",
    "overlay": "#3c3731",
    "highlight_low": "#4a443d",
    "highlight_med": "#564f47",
    "highlight_high": "#675f54",
    "bg_red": "#3d2520",
    "bg_green": "#2a3522",
    "bg_blue": "#1e3038",
    "bg_visual": "#4a3828",
    "text": "#e5c7a9",
    "terracotta": "#ff645a",
    "clay": "#d0633d",
    "amber": "#f5ae2e",
    "oak": "#509552",
    "sage": "#1398b9",
    "moss": "#85c54c",
    "leaf": "#98e036",
    "muted": "#675f54",
    "subtle": "#8a7e70",
    "dim": "#9e9080"
  },
  "theme": {
    "primary":                  { "dark": "sage",        "light": "sage" },
    "secondary":                { "dark": "moss",        "light": "moss" },
    "accent":                   { "dark": "clay",        "light": "clay" },
    "error":                    { "dark": "terracotta",  "light": "terracotta" },
    "warning":                  { "dark": "amber",       "light": "amber" },
    "success":                  { "dark": "oak",         "light": "oak" },
    "info":                     { "dark": "sage",        "light": "sage" },
    "text":                     { "dark": "text",        "light": "text" },
    "textMuted":                { "dark": "dim",         "light": "dim" },
    "thinking":                 { "dark": "amber",       "light": "amber" },
    "background":               { "dark": "base",        "light": "base" },
    "backgroundPanel":          { "dark": "surface",     "light": "surface" },
    "backgroundElement":        { "dark": "overlay",     "light": "overlay" },
    "border":                   { "dark": "highlight_low",  "light": "highlight_low" },
    "borderActive":             { "dark": "sage",        "light": "sage" },
    "borderSubtle":             { "dark": "highlight_med", "light": "highlight_med" },
    "diffAdded":                { "dark": "oak",         "light": "oak" },
    "diffRemoved":              { "dark": "terracotta",  "light": "terracotta" },
    "diffContext":              { "dark": "dim",         "light": "dim" },
    "diffHunkHeader":           { "dark": "subtle",      "light": "subtle" },
    "diffHighlightAdded":       { "dark": "moss",        "light": "moss" },
    "diffHighlightRemoved":     { "dark": "clay",        "light": "clay" },
    "diffAddedBg":              { "dark": "bg_green",    "light": "bg_green" },
    "diffRemovedBg":            { "dark": "bg_red",      "light": "bg_red" },
    "diffContextBg":            { "dark": "surface",     "light": "surface" },
    "diffLineNumber":           { "dark": "muted",       "light": "muted" },
    "diffAddedLineNumberBg":    { "dark": "bg_green",    "light": "bg_green" },
    "diffRemovedLineNumberBg":  { "dark": "bg_red",      "light": "bg_red" },
    "markdownText":             { "dark": "text",        "light": "text" },
    "markdownHeading":          { "dark": "sage",        "light": "sage" },
    "markdownLink":             { "dark": "sage",        "light": "sage" },
    "markdownLinkText":         { "dark": "moss",        "light": "moss" },
    "markdownCode":             { "dark": "moss",        "light": "moss" },
    "markdownBlockQuote":       { "dark": "subtle",      "light": "subtle" },
    "markdownEmph":             { "dark": "text",        "light": "text" },
    "markdownStrong":           { "dark": "text",        "light": "text" },
    "markdownHorizontalRule":   { "dark": "muted",       "light": "muted" },
    "markdownListItem":         { "dark": "sage",        "light": "sage" },
    "markdownListEnumeration":  { "dark": "clay",        "light": "clay" },
    "markdownImage":            { "dark": "sage",        "light": "sage" },
    "markdownImageText":        { "dark": "moss",        "light": "moss" },
    "markdownCodeBlock":        { "dark": "text",        "light": "text" },
    "syntaxComment":            { "dark": "subtle",      "light": "subtle" },
    "syntaxKeyword":            { "dark": "terracotta",  "light": "terracotta" },
    "syntaxFunction":           { "dark": "moss",        "light": "moss" },
    "syntaxVariable":           { "dark": "text",        "light": "text" },
    "syntaxString":             { "dark": "oak",         "light": "oak" },
    "syntaxNumber":             { "dark": "amber",       "light": "amber" },
    "syntaxType":               { "dark": "leaf",        "light": "leaf" },
    "syntaxOperator":           { "dark": "clay",        "light": "clay" },
    "syntaxPunctuation":        { "dark": "dim",         "light": "dim" }
  }
}
