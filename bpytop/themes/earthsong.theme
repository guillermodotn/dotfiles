# Theme: earthsong
# Warm earth tones with vibrant cool accents
# Compatible with both btop and bpytop

theme[main_bg]="#292520"
theme[main_fg]="#e5c7a9"

# Title — sage (primary accent, cool cyan)
theme[title]="#1398b9"

# Keyboard shortcuts highlight — sage (primary accent)
theme[hi_fg]="#1398b9"

# Selected process
theme[selected_bg]="#3c3731"
theme[selected_fg]="#e5c7a9"

# Inactive/disabled text
theme[inactive_fg]="#322d27"

# Graph text labels (uptime, scale)
theme[graph_text]="#9a8b7a"

# Meter background track
theme[meter_bg]="#3c3731"

# Process box misc — sage (primary accent)
theme[proc_misc]="#1398b9"

# Box outlines — each box gets its role color, dim variant
# cpu  → sage      (primary accent, cool)
# mem  → oak       (ok/free = forest green)
# net  → amber     (data flow = warm yellow)
# proc → clay      (secondary accent, orange-brown)
theme[cpu_box]="#0d6e85"
theme[mem_box]="#376a3a"
theme[net_box]="#a87820"
theme[proc_box]="#923f22"
theme[div_line]="#3c3731"

# Temperature graph: oak → amber → terracotta
theme[temp_start]="#509552"
theme[temp_mid]="#f5ae2e"
theme[temp_end]="#ff645a"

# CPU graph: oak → amber → terracotta
theme[cpu_start]="#509552"
theme[cpu_mid]="#f5ae2e"
theme[cpu_end]="#ff645a"

# Mem/Disk free meter: oak shades (free = good = green)
theme[free_start]="#85c54c"
theme[free_mid]="#509552"
theme[free_end]="#376a3a"

# Mem/Disk cached meter: moss → leaf shades
theme[cached_start]="#98e036"
theme[cached_mid]="#85c54c"
theme[cached_end]="#509552"

# Mem/Disk available meter: oak shades
theme[available_start]="#85c54c"
theme[available_mid]="#509552"
theme[available_end]="#376a3a"

# Mem/Disk used meter: amber → clay → terracotta (caution → warning → danger)
theme[used_start]="#f5ae2e"
theme[used_mid]="#d0633d"
theme[used_end]="#ff645a"

# Download graph: sage → moss → leaf
theme[download_start]="#1398b9"
theme[download_mid]="#85c54c"
theme[download_end]="#98e036"

# Upload graph: clay → amber → oak
theme[upload_start]="#d0633d"
theme[upload_mid]="#f5ae2e"
theme[upload_end]="#509552"

# Process gradient: oak → sage → moss
theme[process_start]="#509552"
theme[process_mid]="#1398b9"
theme[process_end]="#85c54c"
